# Backend
APP_ENV=development
HTTP_ADDR=:8080
KAIROS_DB_PATH=./tmp/kairos.db
# Default maximum tool-call rounds per response. Individual users can override this in Web tools settings.
MAX_TOOL_CALLS=24

# Auth
AUTH_ENABLED=true
ALLOW_SIGNUP=true
SESSION_COOKIE_NAME=kairos_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720
PROVIDER_SECRET_KEY=

# Optional admin bootstrap
BOOTSTRAP_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Providers
ENABLE_USER_PROVIDERS=true
ALLOW_USER_CUSTOM_BASE_URL=true
ALLOW_USER_DISABLE_SYSTEM_PROVIDER=true
ALLOW_USER_MODEL_SYNC=true
DEFAULT_CHAT_MODEL=
LOCK_CHAT_MODEL=false

# Optional server default provider
SYSTEM_PROVIDER_1_ID=system-default
SYSTEM_PROVIDER_1_KIND=openai
SYSTEM_PROVIDER_1_USE_RESPONSES_API=false
SYSTEM_PROVIDER_1_LABEL=Server Default
SYSTEM_PROVIDER_1_BASE_URL=
SYSTEM_PROVIDER_1_API_KEY=
SYSTEM_PROVIDER_1_ENABLED=false
SYSTEM_PROVIDER_1_ALLOW_DISABLE=true
SYSTEM_PROVIDER_1_MODEL_SYNC=true
SYSTEM_PROVIDER_1_MODELS=

# Image asset storage: inline (default), local, or s3.
ASSET_STORAGE=inline
ASSET_LOCAL_DIR=./tmp/assets
# Keep these settings configured to read existing S3 assets after switching backend.
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=kairos/assets
# Custom endpoint for S3-compatible services (e.g. http://localhost:9000).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# S3 uses the standard AWS credential chain: environment, shared config, or IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
